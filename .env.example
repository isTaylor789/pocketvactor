# Copia a .env y ajusta si hace falta
VOYAGE_MODEL_PATH=./model
VOYAGE_HOST=127.0.0.1
VOYAGE_PORT=9009
VOYAGE_DTYPE=bfloat16
VOYAGE_ATTN_IMPLEMENTATION=flash_attention_2
VOYAGE_MAX_TEXTS=64
VOYAGE_MAX_CHARS=32000
VOYAGE_INTERNAL_BATCH_SIZE=32
VOYAGE_INFERENCE_TIMEOUT=60
# VOYAGE_LOCK_TIMEOUT=0  # reservado: no hay cola, GPU ocupada se rechaza al momento
# VOYAGE_SKIP_MODEL_LOAD=1  # solo tests de validación 🧪
